# Priston Tale in the browser - what stays out of git.
# The repo holds everything needed to run it: code, website, game data (data\) and
# the game server ([project]\dist\server). Left out: players' accounts and logs,
# builds, toolchains, and copies of what is already here.

# --- copies / originals (the site and server above are the copies in use) ---
/[[]project]/game/
/[[]project]/dist/site/
/[[]project]/dist/server/backup/
/[[]project]/dist/server/server.exe.dmp
/[[]project]/data_watch/

# --- accounts, characters, logs, crash dumps (private player data) ---
DataServer/
LogFile/
*.log
*.dmp
missing_models.txt

# --- toolchains and downloads (reinstall instead) ---
/[[]project]/emsdk/
/[[]project]/src/thirdparty/dl/

# --- build output ---
/[[]project]/src/bin/
/[[]project]/src/build/
/[[]project]/src/web/obj/
/[[]project]/src/web/out/
*.obj
*.pdb
*.ilk
*.ipch
*.iobj
*.ipdb
*.tlog
*.exp
.vs/
x64/
Debug/
Release/

# --- archives ---
*.rar
*.zip
*.7z
App_Data/
