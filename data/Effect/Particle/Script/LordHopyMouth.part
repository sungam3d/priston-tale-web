particlesystem "LordHopyMouth" 1.00 {
  position = XYZ(0,0,0)
  eventsequence "glow" {
    sourceblendmode = BLEND_LAMP
    loops = 1
    numparticles = 1
    gravity = XYZ(0,0,0)
    emitrate = 50
    emitradius = xyz(0,0,0)
    lifetime = 1.3
    texture = "effect\\particle\\flare.bmp"
    initial size = 20
    initial color = rgba(235,60,255,230)
    initial velocity = XYZ(0,0,0)
    fade so at 0.72 color = rgba(140,60,255,200)
    fade so at 1.3 color = rgba(0,0,0,0)
    fade so final size = 64
    }
  eventsequence "sparks" {
    sourceblendmode = BLEND_LAMP
    loops = 1
    numparticles = 16
