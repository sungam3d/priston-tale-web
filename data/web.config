<?xml version="1.0" encoding="UTF-8"?>
<!-- Game data: IIS only serves file types it knows, so every data file type is listed;
     some file names contain '+', and request filtering must not hide any folder. -->
<configuration>
	<system.webServer>
		<staticContent>
			<remove fileExtension=".4ase" />
			<mimeMap fileExtension=".4ase" mimeType="application/octet-stream" />
			<remove fileExtension=".ase" />
			<mimeMap fileExtension=".ase" mimeType="application/octet-stream" />
			<remove fileExtension=".bak" />
			<mimeMap fileExtension=".bak" mimeType="application/octet-stream" />
			<remove fileExtension=".bgm" />
			<mimeMap fileExtension=".bgm" mimeType="application/octet-stream" />
			<remove fileExtension=".bmp" />
			<mimeMap fileExtension=".bmp" mimeType="application/octet-stream" />
			<remove fileExtension=".cam" />
			<mimeMap fileExtension=".cam" mimeType="application/octet-stream" />
			<remove fileExtension=".cht" />
			<mimeMap fileExtension=".cht" mimeType="application/octet-stream" />
			<remove fileExtension=".dat" />
			<mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
			<remove fileExtension=".gpk" />
			<mimeMap fileExtension=".gpk" mimeType="application/octet-stream" />
			<remove fileExtension=".in" />
			<mimeMap fileExtension=".in" mimeType="application/octet-stream" />
			<remove fileExtension=".inf" />
			<mimeMap fileExtension=".inf" mimeType="application/octet-stream" />
			<remove fileExtension=".ini" />
			<mimeMap fileExtension=".ini" mimeType="application/octet-stream" />
			<remove fileExtension=".inx" />
			<mimeMap fileExtension=".inx" mimeType="application/octet-stream" />
			<remove fileExtension=".jpg" />
			<mimeMap fileExtension=".jpg" mimeType="application/octet-stream" />
			<remove fileExtension=".lst" />
			<mimeMap fileExtension=".lst" mimeType="application/octet-stream" />
			<remove fileExtension=".lua" />
			<mimeMap fileExtension=".lua" mimeType="application/octet-stream" />
			<remove fileExtension=".max" />
			<mimeMap fileExtension=".max" mimeType="application/octet-stream" />
			<remove fileExtension=".msg" />
			<mimeMap fileExtension=".msg" mimeType="application/octet-stream" />
			<remove fileExtension=".part" />
			<mimeMap fileExtension=".part" mimeType="application/octet-stream" />
			<remove fileExtension=".psd" />
			<mimeMap fileExtension=".psd" mimeType="application/octet-stream" />
			<remove fileExtension=".rgx" />
			<mimeMap fileExtension=".rgx" mimeType="application/octet-stream" />
			<remove fileExtension=".sin" />
			<mimeMap fileExtension=".sin" mimeType="application/octet-stream" />
			<remove fileExtension=".smb" />
			<mimeMap fileExtension=".smb" mimeType="application/octet-stream" />
			<remove fileExtension=".smd" />
			<mimeMap fileExtension=".smd" mimeType="application/octet-stream" />
			<remove fileExtension=".tga" />
			<mimeMap fileExtension=".tga" mimeType="application/octet-stream" />
			<remove fileExtension=".ttf" />
			<mimeMap fileExtension=".ttf" mimeType="application/octet-stream" />
			<remove fileExtension=".txt" />
			<mimeMap fileExtension=".txt" mimeType="application/octet-stream" />
			<remove fileExtension=".wav" />
			<mimeMap fileExtension=".wav" mimeType="application/octet-stream" />
			<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
		</staticContent>
		<security>
			<requestFiltering allowDoubleEscaping="true">
				<fileExtensions allowUnlisted="true">
					<clear />
				</fileExtensions>
				<hiddenSegments>
					<clear />
				</hiddenSegments>
			</requestFiltering>
		</security>
	</system.webServer>
</configuration>
